{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.2.1",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "*://*.ashbyhq.com/*",
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.workable.com/*",
    "*://*.linkedin.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_appName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.ashbyhq.com/*",
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.workable.com/*",
        "*://*.linkedin.com/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "js": [
        "shared/default-profile.js",
        "content/form-helpers.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
